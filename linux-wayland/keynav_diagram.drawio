        <mxCell id="mhinIYfKRZyUOLAsjX1K-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="BIND: CHAIN | SEQUENCE&amp;nbsp;&lt;div&gt;&lt;br&gt;CHAIN: sequence of keys presed (and not released) as if it was some sort of graph or contextual menu&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SEQUENCE: sequence of keys pressed and released&lt;/div&gt;&lt;div&gt;personal note: i believe this can be implemented with a stack with defined size, the last clicked key can be clicked again to pop it, and esc can be clicked to restart the sequence&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="105" y="100" as="geometry" />
        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Responsabilities:&lt;div&gt;- recieve press, held and release keys events and maintains the binds in course&lt;/div&gt;&lt;div&gt;- with every modification to such binds, and with the commands loaded in the current state {mouse, vim, transparent}, it can consult each state if it has it, it can consult the corresponding event and throw it in the bus&lt;span style=&quot;background-color: transparent; white-space: nowrap; color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px;&quot;&gt;%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20parent%3D%221%22%20style%3D%22text%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3Boverflow%3Dhidden%3Brounded%3D0%3B%22%20value%3D%22%26lt%3Bh1%20style%3D%26quot%3Bmargin-top%3A%200px%3B%26quot%3B%26gt%3BGUI%26lt%3B%2Fh1%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%22120%22%20width%3D%22180%22%20x%3D%221130%22%20y%3D%22420%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space: nowrap; color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20parent%3D%221%22%20style%3D%22text%3Bhtml%3D1%3BwhiteSpace%3Dwrap%3Boverflow%3Dhidden%3Brounded%3D0%3B%22%20value%3D%22%26lt%3Bh1%20style%3D%26quot%3Bmargin-top%3A%200px%3B%26quot%3B%26gt%3BGUI%26lt%3B%2Fh1%26gt%3B%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%22120%22%20width%3D%22180%22%20x%3D%221130%22%20y%3D%22420%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxG&lt;