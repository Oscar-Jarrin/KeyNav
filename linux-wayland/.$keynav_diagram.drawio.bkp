        <mxCell id="mhinIYfKRZyUOLAsjX1K-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Responsabilities:&lt;div&gt;- Capture the physical keyboard events&lt;/div&gt;&lt;div&gt;- Send those events to the keynavState module to process&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="-560" y="350" as="geometry" />
