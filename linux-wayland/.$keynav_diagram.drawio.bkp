        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Control" vertex="1">
          <mxGeometry height="60" width="120" x="2120" y="630" as="geometry" />
        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Select" vertex="1">
          <mxGeometry height="60" width="120" x="1880" y="630" as="geometry" />
        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="BIND: CHAIN | SEQUENCE&amp;nbsp;&lt;div&gt;&lt;br&gt;CHAIN: sequence of keys presed (and not released) as if it was some sort of graph or contextual menu&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SEQUENCE: sequence of keys pressed and released&lt;/div&gt;&lt;div&gt;personal note: i believe this can be implemented with a stack with defined size, the last clicked key can be clicked again to pop it, and esc can be clicked to restart the sequence&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="-200" as="geometry" />
        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Responsabilities:&lt;div&gt;This is a State pattern, the responsibility of which is to recieve binds sent from the BindTracker, and manage them (reject or take the necessary actions) depending on the Binds in the current Configuration&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- If a bind should be managed, then the specific state will emit the&amp;nbsp; corresponding Signal provided by the state-specific Inrerface of the Keynav Event Bus&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;Event Bus. Maybe there will be.&lt;br&gt;- MouseSignalsBus&lt;/div&gt;&lt;div&gt;- VimSignasBus&lt;/div&gt;&lt;div&gt;- TransparentSignals&lt;/div&gt;&lt;div&gt;- ConfigurationSignals&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The Keynav State module itself, will have the responsability of handling the specific-state changes&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="310" x="190" y="180" as="geometry" />
        </mxCell>
        <mxCell id="mhinIYfKRZyUOLAsjX1K-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Responsabilities:&lt;div&gt;- load the configuration for every action, and create binds&lt;/div&gt;&lt;div&gt;- respond to the request, contains (bind) and get&lt;br&gt;Effect (bind)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="-380" y="789" as="geometry" />
        </mxCell>
        <mxCell id="xJq9ODD-ZaJNfxWmDRdk-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=1;" value="Holds All the QtSignals that the KeynavState can emit, and to which the GUI and HW modules can connect their sockets to.&lt;br&gt;&lt;br&gt;Implements different Interfaces to comply with the Interface Segregation Principle&lt;br&gt;Maybe &lt;br&gt;- HUDSignalsBus&lt;br&gt;- HardwareSignalsBus&lt;div&gt;- ConfigInteraction&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="590" y="250" as="geometry" />
        </mxCell>
        <mxCell id="xJq9ODD-ZaJNfxWmDRdk-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=1;" value="These two modules connect their sockets to the Signals they are concerned with, and are responsible to react in consequence.&lt;br&gt;&lt;br&gt;More detail on what actions&amp;nbsp;each module has, will be given later" vertex="1">
          <mxGeometry height="190" width="310" x="1070" y="430" as="geometry" />
        </mxCell>
        <mxCell id="xJq9ODD-ZaJNfxWmDRdk-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Hw Simulator" vertex="1">
          <mxGeometry height="60" width="120" x="920" y="479" as="geometry" />
        </mxCell>
        <mxCell id="xJq9ODD-ZaJNfxWmDRdk-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Note: There are two different sets of Interfaces for the EventsBus.&amp;nbsp;&lt;br&gt;Because the Signals that a specific state can only access/emit a specific set of Signals, but these can concern different end Modules (HUD, Config GUI or HW Simulator)" vertex="1">
          <mxGeometry height="100" width="310" x="590" y="130" as="geometry" />
        </mxCell>
        <mxCell id="zqRG4q7P6jlk8HvdjYon-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Config State" vertex="1">
          <mxGeometry height="60" width="120" x="-20" y="603" as="geometry" />
        </mxCell>
        <mxCell id="zqRG4q7P6jlk8HvdjYon-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Responsabilities:&lt;div&gt;- recieve press, held and release keys events from the OS specific Input Listen and maintains the bind in course&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- every modification to the current bind, it is sent to the Keynav State to manage it&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Note: just identyfies if its a chord or a sequence. Not if it is correct. The Keynav State decides that&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="-200" y="290" as="geometry" />
        </mxCell>
        <mxCell id="zqRG4q7P6jlk8HvdjYon-4" edge="1" parent="1" source="zqRG4q7P6jlk8HvdjYon-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="BWI9OO-LOAWzsL8Un-7o-2">
